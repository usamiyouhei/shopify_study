{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}
{{ 'cart.css' | asset_url | stylesheet_tag }}
<section class="cart">
  <h1>{{ 'cart.title' | t }}</h1>

  <form action="{{ routes.cart_url }}" method="post" class="cart__form">
    <table class="cart__table">
      {% for item in cart.items %}
        <tr class="cart-item">
          <td class="cart-item__media">
            {% render 'image', image: item.image, url: item.url %}
          </td>
          <td class="cart-item__info">
            <p class="cart-item__title">{{ item.product.title }}</p>

            <p class="cart-item__variant">{{ item.variant.title }}</p>

            <p class="cart-item__price">{{ item.final_price | money }}</p>
            {{ 'cart.remove' | t | link_to: item.url_to_remove }}
          </td>
          <td class="cart-item__quantity">
            <input type="number" name="updates[]" value="{{ item.quantity }}" min="0">
            <input type="submit" value="{{ 'cart.update' | t }}">
          </td>

          <td class="cart-item__subtotal">
            <p>{{ item.final_line_price | money }}</p>
          </td>
        </tr>
      {% endfor %}
    </table>
    <div class="cart-total">
      <p>Total: {{ cart.total_price | money }}</p>
    </div>

    <input type="submit" name="checkout" value="{{ 'cart.checkout' | t }}">
  </form>
</section>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
