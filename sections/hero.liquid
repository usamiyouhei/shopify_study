<section class="hero">
<div class="hero__inner">
  <p class="hero__eyebrow">UTSUWA COLLECTION</p>

  <h1>{{ section.settings.heading }}</h1>

  <p>{{ section.settings.text }}</p>
</div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Japanese Tableware"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover beautiful tableware for everyday dining."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}