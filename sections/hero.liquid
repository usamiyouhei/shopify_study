<section class="hero">
<div class="hero__inner">
  <p class="hero__eyebrow">UTSUWA COLLECTION</p>

  <h1>{{ section.settings.heading }}</h1>

  <p>{{ section.settings.text }}</p>

  {%  if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_link }}" class="hero__button">
      {{ section.settings.button_label }}
    </a>
  {% endif %}

</div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Japanese Tableware"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover beautiful tableware for everyday dining."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}